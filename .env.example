# Copy this file to .env.local and fill in the values.
# Never commit .env.local.

# REQUIRED. Your Sazito store domain WITHOUT https:// (example: yourstore.sazito.com)
SAZITO_DOMAIN=

# OPTIONAL. Only if your Sazito store requires an API key. Server-side only.
SAZITO_API_KEY=

# REQUIRED for production (canonical URLs, sitemap, Open Graph, payment return).
# Example: https://monawear.ir   (use http://localhost:3000 for local development)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
